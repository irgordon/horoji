#!/usr/bin/env python3
"""Validate authoritative ownership mappings."""

from __future__ import annotations

import argparse
import os
import sys

from _validator_common import (
    EXPECTED_JSON_LOAD_ERRORS,
    EXPECTED_YAML_LOAD_ERRORS,
    compute_repo_root,
    emit_yaml,
    is_valid_identifier,
    load_json,
    load_yaml,
    make_result,
    memory_root,
    normalize_path,
    validate_against_schema,
    yaml_files_in,
)

VALIDATOR = "validate-ownership"

ACTIVE_TOOL_SURFACES = {
    "tools/horoji/cli/**": "horoji_cli",
    "tools/horoji/generators/**": "horoji_generators",
    "tools/horoji/invalidation/**": "horoji_invalidation",
    "tools/horoji/validators/**": "horoji_validators",
}


def _pattern_overlap(p1: str, p2: str) -> bool:
    if p1 == p2:
        return True

    def _prefix(pattern: str) -> str | None:
        if pattern.endswith("/**"):
            return pattern[:-2]
        return None

    p1_prefix = _prefix(p1)
    p2_prefix = _prefix(p2)

    if p1_prefix and p2.startswith(p1_prefix):
        return True
    if p2_prefix and p1.startswith(p2_prefix):
        return True

    return False


def main() -> None:
    parser = argparse.ArgumentParser(description="Validate Horoji ownership")
    parser.add_argument("--repo-root", help="Repository root override")
    args = parser.parse_args()

    repo_root = compute_repo_root(__file__, args.repo_root)
    ownership_dir, contracts_dir, schema_file = ownership_validation_paths(repo_root)

    schema = load_ownership_schema(schema_file, repo_root)
    known_owners = collect_contract_owners(contracts_dir, repo_root)
    ownership_files = discover_ownership_files(ownership_dir, repo_root)
    records = collect_ownership_records(ownership_files, schema, known_owners, repo_root)
    validate_ownership_overlaps(records)
    validate_active_surface_ownership(records)

    emit_yaml(
        make_result(
            VALIDATOR,
            "PASS",
            ".project_memory/authoritative/ownership",
            "all_ownership_records_valid",
            [f"count={len(ownership_files)}"],
        )
    )


def ownership_validation_paths(repo_root: str) -> tuple[str, str, str]:
    mem_root = memory_root(repo_root)
    return (
        os.path.join(mem_root, "authoritative", "ownership"),
        os.path.join(mem_root, "authoritative", "contracts"),
        os.path.join(mem_root, "schemas", "ownership.schema.json"),
    )


def load_ownership_schema(schema_file: str, repo_root: str) -> dict:
    try:
        return load_json(schema_file)
    except EXPECTED_JSON_LOAD_ERRORS as exc:
        fail_validation(repo_root, schema_file, "ERROR", "configuration_error", [str(exc)])


def collect_contract_owners(contracts_dir: str, repo_root: str) -> set[str]:
    known_owners: set[str] = set()
    for contract_file in yaml_files_in(contracts_dir):
        known_owners.update(load_contract_owner(contract_file, repo_root))
    return known_owners


def load_contract_owner(contract_file: str, repo_root: str) -> set[str]:
    try:
        contract_data = load_yaml(contract_file)
    except EXPECTED_YAML_LOAD_ERRORS as exc:
        fail_validation(repo_root, contract_file, "ERROR", "contract_parse_error", [str(exc)])

    if isinstance(contract_data, dict) and isinstance(contract_data.get("subsystem"), str):
        return {contract_data["subsystem"]}
    return set()


def discover_ownership_files(ownership_dir: str, repo_root: str) -> list[str]:
    ownership_files = yaml_files_in(ownership_dir)
    if not ownership_files:
        fail_validation(repo_root, ownership_dir, "FAIL", "no_ownership_files")
    return ownership_files


def collect_ownership_records(
    ownership_files: list[str],
    schema: dict,
    known_owners: set[str],
    repo_root: str,
) -> list[tuple[str, str, str]]:
    records: list[tuple[str, str, str]] = []
    seen_patterns: dict[str, str] = {}
    for path in ownership_files:
        record = validate_ownership_file(path, schema, known_owners, repo_root)
        target, pattern, owner = record
        validate_duplicate_pattern(pattern, owner, target, seen_patterns)
        seen_patterns[pattern] = owner
        records.append(record)
    return records


def validate_ownership_file(
    path: str,
    schema: dict,
    known_owners: set[str],
    repo_root: str,
) -> tuple[str, str, str]:
    target = normalize_path(path, repo_root)
    data = load_ownership_document(path, target)
    validate_ownership_schema(data, schema, target)
    pattern = validate_ownership_pattern(data, target)
    owner = validate_ownership_owner(data, known_owners, target)
    validate_review_authorities(data, target)
    return target, pattern, owner


def load_ownership_document(path: str, target: str) -> dict:
    try:
        data = load_yaml(path)
    except EXPECTED_YAML_LOAD_ERRORS as exc:
        fail_target(target, "ERROR", "parse_error", [str(exc)])

    if not isinstance(data, dict):
        fail_target(target, "FAIL", "ownership_not_mapping")
    return data


def validate_ownership_schema(data: dict, schema: dict, target: str) -> None:
    schema_errors = validate_against_schema(data, schema)
    if schema_errors:
        fail_target(target, "FAIL", "schema_validation_failed", schema_errors)


def validate_ownership_pattern(data: dict, target: str) -> str:
    pattern = data.get("pattern", "")
    if not isinstance(pattern, str) or pattern.strip() == "":
        fail_target(target, "FAIL", "empty_pattern")
    return pattern


def validate_ownership_owner(data: dict, known_owners: set[str], target: str) -> str:
    owner = data.get("owner", "")
    if not isinstance(owner, str) or owner.strip() == "":
        fail_target(target, "FAIL", "empty_owner")
    if not is_valid_identifier(owner):
        fail_target(target, "FAIL", "invalid_owner_identifier")
    if known_owners and owner not in known_owners:
        fail_target(target, "FAIL", "unknown_owner_subsystem", [owner])
    return owner


def validate_review_authorities(data: dict, target: str) -> None:
    review_required = data.get("review_required")
    if review_required is None:
        return
    if not isinstance(review_required, list):
        fail_target(target, "FAIL", "review_required_not_list")
    for reviewer in review_required:
        validate_review_authority(reviewer, target)


def validate_review_authority(reviewer: object, target: str) -> None:
    if not isinstance(reviewer, str) or reviewer.strip() == "":
        fail_target(target, "FAIL", "invalid_review_authority")


def validate_duplicate_pattern(
    pattern: str,
    owner: str,
    target: str,
    seen_patterns: dict[str, str],
) -> None:
    if pattern in seen_patterns and seen_patterns[pattern] != owner:
        fail_target(
            target,
            "FAIL",
            "conflicting_duplicate_pattern",
            [pattern, seen_patterns[pattern], owner],
        )


def validate_ownership_overlaps(records: list[tuple[str, str, str]]) -> None:
    conflict = first_ownership_overlap(records)
    if conflict is None:
        return
    target, details = conflict
    fail_target(target, "FAIL", "overlapping_ownership_conflict", details)


def first_ownership_overlap(
    records: list[tuple[str, str, str]]
) -> tuple[str, list[str]] | None:
    for first, second in ownership_record_pairs(records):
        conflict = ownership_overlap(first, second)
        if conflict is not None:
            return conflict
    return None


def ownership_record_pairs(
    records: list[tuple[str, str, str]]
) -> list[tuple[tuple[str, str, str], tuple[str, str, str]]]:
    return [
        (records[i], records[j])
        for i in range(len(records))
        for j in range(i + 1, len(records))
    ]


def ownership_overlap(
    first: tuple[str, str, str],
    second: tuple[str, str, str],
) -> tuple[str, list[str]] | None:
    target_a, pattern_a, owner_a = first
    target_b, pattern_b, owner_b = second
    if owner_a == owner_b or not _pattern_overlap(pattern_a, pattern_b):
        return None
    return (
        f"{target_a}::{target_b}",
        [pattern_a, pattern_b, owner_a, owner_b],
    )


def validate_active_surface_ownership(records: list[tuple[str, str, str]]) -> None:
    owned_surfaces = {(pattern, owner) for _, pattern, owner in records}
    for required_pattern, required_owner in sorted(ACTIVE_TOOL_SURFACES.items()):
        if (required_pattern, required_owner) not in owned_surfaces:
            fail_target(
                ".project_memory/authoritative/ownership",
                "FAIL",
                "missing_active_tool_surface_ownership",
                [f"{required_pattern}:{required_owner}"],
            )


def fail_validation(
    repo_root: str,
    path: str,
    status: str,
    reason: str,
    details: list[object] | None = None,
) -> None:
    fail_target(normalize_path(path, repo_root), status, reason, details)


def fail_target(
    target: str,
    status: str,
    reason: str,
    details: list[object] | None = None,
) -> None:
    emit_yaml(make_result(VALIDATOR, status, target, reason, details))
    sys.exit(1)


if __name__ == "__main__":
    main()
